{
  "name": "candidate-queue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.2.19",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:push": "bun scripts/apply-schema.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "bun tests/db/rules.test.mjs && bun tests/db/privacy.test.mjs && bun tests/db/events.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "bun run test && bun run test:db && bun run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "papaparse": "^5.4.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.10.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  }
}
