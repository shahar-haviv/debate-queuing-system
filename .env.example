# ---------------------------------------------------------------------------
# Runtime configuration (compiled into the browser bundle by Vite).
#
# Copy this file to `.env` and fill in both required values from
# Supabase Dashboard -> Project Settings -> API. The app validates them at
# startup with zod and shows a configuration screen if either is missing.
#
# Only the publishable ("anon") key ever belongs here. NEVER put the
# service_role / secret key in a VITE_* variable - Vite inlines those into
# JavaScript that every visitor downloads.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: `development` | `staging` | `production` (defaults to development).
# VITE_APP_ENV=development

# Optional log threshold: debug | info | warn | error (defaults to info).
# VITE_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# CLI-only credentials for `bun run db:push`.
#
# These are read by the Node-side script, never by the browser, and are not
# prefixed with VITE_. Use ONE of them. Keep `.env` out of version control.
# ---------------------------------------------------------------------------

# Recommended: a Supabase Management API personal access token.
# SUPABASE_ACCESS_TOKEN=sbp_your_access_token

# Alternative: the database password chosen when the project was created.
# SUPABASE_DB_PASSWORD=your_database_password

# The pre-confirmed admin account created by the schema script.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-running-db-push
